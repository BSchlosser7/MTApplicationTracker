# Copy this file to .env.local and fill in your Supabase project's values.
# Dashboard → Project Settings → API.
#
# SUPABASE_URL is the "Project URL".
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key — NOT the
# "anon" / "publishable" key. This app only ever calls Supabase from the
# server (API routes), so the service_role key is safe to use here — just
# never prefix it with NEXT_PUBLIC_ or send it to the browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
