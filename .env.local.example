# Copy this file to .env.local and fill in your Supabase project's values.
# Dashboard → Project Settings → API.
#
# SUPABASE_URL is the "Project URL".
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key — NOT the
# "anon" / "publishable" key. This app only ever calls Supabase from the
# server (API routes), so the service_role key is safe to use here — just
# never prefix it with NEXT_PUBLIC_ or send it to the browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: gates the whole site behind a single shared password. Leave
# unset to leave the site open (e.g. for local dev). Set this in Vercel's
# env vars too if you want the deployed site protected.
SITE_PASSWORD=

# Powers the Chat page (Ask the Tracker). Get a key at console.anthropic.com.
# Server-only — never exposed to the browser. Set this in Vercel's env vars
# too if you want chat to work on the deployed site.
ANTHROPIC_API_KEY=
